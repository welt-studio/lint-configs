{
  "compilerOptions": {
    "strict": true,
    "target": "ES2025",
    "lib": ["ES2025", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
