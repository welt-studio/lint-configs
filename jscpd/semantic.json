{
  "format": ["python", "typescript", "tsx", "javascript", "jsx", "rust"],
  "ignore": [
    "**/*.gen.ts",
    "**/migrations/**",
    "**/alembic/versions/**",
    "**/vendor/**",
    "**/*.min.js",
    "**/*.min.mjs",
    "**/*.min.cjs",
    "**/*.min.css",
    "**/tests/**",
    "**/__tests__/**",
    "**/test/**",
    "**/e2e/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/conftest.py",
    "**/tests.rs"
  ],
  "semantic": { "enabled": true, "scope": "same" },
  "kind": ["semantic"],
  "reporters": ["json"],
  "noColors": true,
  "noTips": true
}
