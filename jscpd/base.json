{
  "format": ["python", "typescript", "tsx", "javascript", "jsx", "rust"],
  "ignore": [
    "**/*.gen.ts",
    "**/migrations/**",
    "**/alembic/versions/**",
    "**/vendor/**",
    "**/*.min.js",
    "**/*.min.mjs",
    "**/*.min.cjs",
    "**/*.min.css"
  ],
  "ignorePattern": [
    "(?m)^[ \\t]*from[ \\t]+[.\\w]+[ \\t]+import[ \\t]+(\\([^)]*\\)|.*)$",
    "(?m)^[ \\t]*import[ \\t]+[\\w.]+([ \\t]+as[ \\t]+\\w+)?([ \\t]*,[ \\t]*[\\w.]+([ \\t]+as[ \\t]+\\w+)?)*[ \\t]*$",
    "(?m)^import\\s[^;]*?\\bfrom\\s+\"[^\"]+\";?",
    "(?m)^import\\s+\"[^\"]+\";?"
  ],
  "reporters": ["console"],
  "exitCode": 1,
  "noColors": true,
  "noTips": true
}
